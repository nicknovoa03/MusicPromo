{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_EXPORT_QUALITY_PROFILE": "high",
        "EXPO_PUBLIC_RENDER_ENGINE": "ffmpeg"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
