{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_LAUNCH_SCOPE": "music-promo-only",
        "EXPO_PUBLIC_EXPORT_QUALITY_PROFILE": "high",
        "EXPO_PUBLIC_RENDER_ENGINE": "ffmpeg"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_LAUNCH_SCOPE": "music-promo-only",
        "EXPO_PUBLIC_EXPORT_QUALITY_PROFILE": "high",
        "EXPO_PUBLIC_RENDER_ENGINE": "ffmpeg"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
