{
  "name": "music-promo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:go:lan": "expo start --go --lan",
    "start:go:tunnel": "expo start --go --tunnel",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel --clear --scheme musicpromo",
    "start:dev-client:phase5": "EXPO_PUBLIC_IOS_NATIVE_UI_PHASE5=1 expo start --dev-client --tunnel --clear --scheme musicpromo",
    "start:dev-client:phase5:lan": "EXPO_PUBLIC_IOS_NATIVE_UI_PHASE5=1 expo start --dev-client --host lan --clear --scheme musicpromo",
    "start:go:fast": "expo start --go --lan --no-dev --minify",
    "atlas:start": "EXPO_ATLAS=true expo start --go --lan",
    "atlas:export:ios": "EXPO_ATLAS=true npx expo export --platform ios",
    "atlas:export:android": "EXPO_ATLAS=true npx expo export --platform android",
    "atlas:open": "npx expo-atlas .expo/atlas.jsonl",
    "atlas:ios": "npm run atlas:export:ios && npm run atlas:open",
    "atlas:android": "npm run atlas:export:android && npm run atlas:open",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "npx tsc --noEmit",
    "lint:convex": "npx tsc --noEmit -p convex/tsconfig.json",
    "lint:all": "npx tsc --noEmit && npx tsc --noEmit -p convex/tsconfig.json",
    "start:dev-client": "expo start --dev-client",
    "preflight:ios": "npx expo config --type introspect",
    "preflight:release": "npx tsc --noEmit && npx tsc --noEmit -p convex/tsconfig.json && npx expo config --type public",
    "build:ios:development": "npx eas build -p ios --profile development",
    "build:ios:production": "npx eas build -p ios --profile production",
    "build:android:preview": "npx eas build -p android --profile preview",
    "deploy:ios:testflight": "npx eas build -p ios --profile production --auto-submit",
    "submit:ios:production": "npx eas submit -p ios --profile production"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.27",
    "@expo/ui": "0.2.0-beta.9",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "convex": "^1.32.0",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "^16.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "ffmpeg-kit-react-native": "npm:ffmpeg-kit-react-native-alt@6.0.6",
    "posthog-react-native": "^4.36.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "expo-atlas": "^0.4.3",
    "typescript": "^5.8.3"
  },
  "private": true
}
