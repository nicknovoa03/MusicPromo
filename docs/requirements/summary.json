{
  "name": "MusicPromo",
  "one_liner": "A dead-simple mobile tool that turns a photo and audio clip into a short promo video for social media.",
  "platforms": ["iOS", "Android"],
  "tech_stack": {
    "framework": "React Native + Expo",
    "auth": "Clerk",
    "backend": "Convex",
    "analytics": "PostHog",
    "video_rendering": "On-device (FFmpeg-kit or equivalent)",
    "notifications": "Expo Push Notifications",
    "sharing": "Native share intents (expo-sharing)"
  },
  "personas": [
    {
      "name": "Indie Artist / Creator",
      "description": "Independent musician or content creator self-promoting on Instagram, TikTok, etc.",
      "v1": true
    },
    {
      "name": "Small Label / Publisher",
      "description": "Record label or publishing company creating promo for a roster of artists.",
      "v1": false
    }
  ],
  "north_star": "Number of videos exported/downloaded",
  "guardrail_metrics": [
    "Video generation time under 60 seconds",
    "App crash rate ~0%",
    "App cold start under 3 seconds"
  ],
  "entities": [
    {
      "name": "User Profile",
      "storage": "Convex",
      "key_fields": ["clerkId", "name", "email", "avatarUrl", "subscriptionTier", "preferences", "createdAt"]
    },
    {
      "name": "Project",
      "storage": "Convex (metadata) + Device (files)",
      "key_fields": ["userId", "title", "templateId", "aspectRatio", "videoLength", "photoUri", "audioUri", "exportedVideoUri", "status", "createdAt", "updatedAt"]
    },
    {
      "name": "Template",
      "storage": "Convex",
      "key_fields": ["id", "name", "description", "previewImageUrl", "type", "config"],
      "v1_entries": ["Spinning CD"]
    },
    {
      "name": "Push Token",
      "storage": "Convex",
      "key_fields": ["userId", "expoPushToken", "platform", "createdAt", "updatedAt"]
    },
    {
      "name": "Notification",
      "storage": "Convex",
      "key_fields": ["id", "userId", "type", "title", "body", "read", "trigger", "sentAt"]
    }
  ],
  "screens": [
    "Sign In / Guest Entry",
    "Onboarding (1-3 screens)",
    "Create (photo + audio + trim + preview + export)",
    "Post-Export Success (save / share / done)",
    "Projects / History",
    "Profile / Settings",
    "Notifications (push, possibly in-app)"
  ],
  "epics": [
    { "name": "Authentication & Guest Mode", "v1": true, "phase": 0 },
    { "name": "Create Promo Video", "v1": true, "phase": 1 },
    { "name": "Save & Share", "v1": true, "phase": 1 },
    { "name": "Project History", "v1": true, "phase": 1 },
    { "name": "Push Notifications", "v1": true, "phase": 2 },
    { "name": "Profile & Settings", "v1": true, "phase": 2 },
    { "name": "Onboarding", "v1": true, "phase": 2 },
    { "name": "SoundCloud Integration", "v1": false, "phase": null },
    { "name": "Additional Video Templates", "v1": false, "phase": null },
    { "name": "AI-Generated Templates", "v1": false, "phase": null },
    { "name": "Label/Agency Multi-User", "v1": false, "phase": null },
    { "name": "Template Marketplace", "v1": false, "phase": null },
    { "name": "Subscription / Monetization", "v1": false, "phase": null }
  ],
  "analytics_events": [
    "app_opened",
    "sign_in_completed",
    "guest_mode_started",
    "onboarding_completed",
    "create_started",
    "photo_selected",
    "audio_selected",
    "preview_viewed",
    "video_exported",
    "video_saved_to_camera_roll",
    "share_tapped_instagram",
    "share_tapped_tiktok",
    "project_reopened",
    "notification_received",
    "notification_tapped"
  ],
  "open_questions": [
    "Navigation pattern (bottom tabs vs hamburger) — pending Mobbin research",
    "Create screen flow/layout — pending Mobbin research",
    "Visual design system (colors, typography, motion) — pending Mobbin research",
    "Onboarding screen design — pending Mobbin research",
    "Tone of voice for UI copy — pending Mobbin research",
    "User Profile exact fields beyond basics — decide before Phase 2",
    "Notification content strategy (messages, frequency) — decide before Phase 2",
    "Verify Clerk supports anonymous sessions in React Native SDK",
    "Verify soft-delete satisfies Apple's account deletion requirement",
    "Expo + FFmpeg-kit compatibility — spike in Phase 0"
  ]
}
