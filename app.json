{
  "expo": {
    "name": "MusicPromo",
    "slug": "music-promo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7aca913d-9634-4d4a-b76e-edfc31229af9",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/MusicPromo-App-Icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "musicpromo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.musicpromo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.musicpromo.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "general",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MusicPromo needs access to your photos to create promo videos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "MusicPromo saves exported videos to your camera roll.",
          "savePhotosPermission": "MusicPromo saves exported videos to your camera roll.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withFfmpegBitcodeStrip",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7aca913d-9634-4d4a-b76e-edfc31229af9"
      }
    }
  }
}
